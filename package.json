{
  "name": "zema-landing",
  "private": true,
  "scripts": {
    "test": "npm run test:content && npm run test:docs && npm run test:workflows && npm run test:uploader && npm run test:regression",
    "test:content": "node scripts/validate-content.js",
    "test:docs": "node scripts/check-docs.js",
    "test:workflows": "actionlint -color .github/workflows/*.yml",
    "test:uploader": "npm run typecheck:uploader && npm run build:uploader && vitest run --config _admin/uploader/vitest.config.mts",
    "typecheck:uploader": "node scripts/check-uploader-types.js && tsc --noEmit -p _admin/uploader/tsconfig.json",
    "build:uploader": "wrangler deploy --dry-run --cwd _admin/uploader --outdir .wrangler/dry-run/admin && wrangler deploy --dry-run --cwd _admin/uploader --config wrangler.source.jsonc --outdir .wrangler/dry-run/source",
    "test:regression": "playwright test",
    "test:accessibility": "playwright test tests/e2e/accessibility-seo.spec.js --grep \"WCAG|enhanced scroll|landmarks|form validation\"",
    "test:seo": "playwright test tests/e2e/accessibility-seo.spec.js --grep \"metadata\"",
    "test:regression:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "jose": "^6.2.10"
  }
}
